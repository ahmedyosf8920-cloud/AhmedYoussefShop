{
  "name": "ahmed-youssef-central",
  "version": "30.4.0",
  "description": "سنترال أحمد يوسف لخدمات المحمول",
  "author": "Ahmed Youssef",
  "main": "desktop/main.js",
  "scripts": {
    "prepare-www": "node scripts/prepare.js",
    "desktop": "node scripts/prepare.js && electron .",
    "dist:win": "node scripts/prepare.js --strict && electron-builder --win --publish never",
    "android:init": "node scripts/prepare.js --strict && npx cap add android && node scripts/android-patch.js && npx cap sync android",
    "android:sync": "node scripts/prepare.js --strict && node scripts/android-patch.js && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ahmedyoussef.central",
    "productName": "Ahmed Youssef Central",
    "artifactName": "AhmedYoussefCentral-${version}-${os}.${ext}",
    "directories": { "output": "dist" },
    "files": ["desktop/**", "www/**", "build/icon.png", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "سنترال أحمد يوسف" }
  }
}
